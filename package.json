    "ketcher-react": "^3.17.2",
    "ketcher-standalone": "^3.17.2",
    "openchemlib": "^9.25.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smiles-drawer": "^2.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.5.4",
    "vitest": "^5.0.3"
